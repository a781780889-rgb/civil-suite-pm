# متغيرات بيئة اختيارية - مساعد الذكاء الاصطناعي (القسم الثالث S3-05، حاسبات القسم الرابع،
# والقسمين السابع والثامن)
# بدون ANTHROPIC_API_KEY تبقى بقية النظام تعمل بشكل طبيعي تماماً فيما عدا ميزات الذكاء
# الاصطناعي في هذه الأقسام - معزولة تماماً ولا تُعطّل أي شيء آخر إن تُركت بلا ضبط.

# مفتاح API من https://console.anthropic.com (يخدم كل الأقسام معاً)
ANTHROPIC_API_KEY=

# اختياري - يسمح بتغيير الموديل المُستخدم في كل قسم دون تعديل الكود لاحقاً
BOQ_AI_MODEL=claude-sonnet-5
PM_AI_MODEL=claude-sonnet-5
EQUIPMENT_AI_MODEL=claude-sonnet-5
HSE_AI_MODEL=claude-sonnet-5
